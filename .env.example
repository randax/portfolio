# Sanity (public)
# NEXT_PUBLIC_SANITY_PROJECT_ID: Your Sanity project ID
#   Find it in Sanity dashboard → Project settings
NEXT_PUBLIC_SANITY_PROJECT_ID=

# NEXT_PUBLIC_SANITY_DATASET: Dataset name (usually "production")
#   Find it in Sanity dashboard → Datasets
NEXT_PUBLIC_SANITY_DATASET=production

# NEXT_PUBLIC_SANITY_API_VERSION: Sanity API version (e.g., 2024-12-01)
#   Use the latest stable date/version you’ve pinned in code
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# Sanity (server)
# SANITY_API_TOKEN: Read token for fetching data (Viewer permissions)
#   Create it in Sanity dashboard → API → Tokens
SANITY_API_TOKEN=

# On-demand revalidation
# REVALIDATE_SECRET: Shared secret used by Sanity webhook → /api/revalidate
#   Generate a secure random value (example):
#   openssl rand -base64 32
REVALIDATE_SECRET=
